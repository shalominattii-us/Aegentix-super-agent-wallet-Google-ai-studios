rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation Blueprint for User Profiles
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'lastLoginAt', 'moltbookHandle']) &&
             data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256;
    }

    // Validation Blueprint for AI Ability Records
    function isValidAbilityRecord(data) {
      return data.keys().hasAll(['type', 'title', 'createdAt']) &&
             data.type is string && data.type.size() <= 64 &&
             data.title is string && data.title.size() <= 512 &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Validation Blueprint for Chat Messages
    function isValidChatMessage(data) {
      return data.keys().hasAll(['role', 'text', 'timestamp']) &&
             data.role in ['user', 'model', 'system'] &&
             data.text is string && data.text.size() <= 10000 &&
             data.timestamp is string && data.timestamp.size() <= 64;
    }

    // Validation Blueprint for Portfolio Growth Plans
    function isValidPortfolioPlan(data) {
      return data.keys().hasAll(['planName', 'initialCapitalUsd', 'updatedAt']) &&
             data.planName is string && data.planName.size() <= 128 &&
             data.initialCapitalUsd is number &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // Validation Blueprint for Trading Credentials
    function isValidTradingCredential(data) {
      return data.keys().hasAll(['provider', 'name', 'type', 'status', 'createdAt']) &&
             data.provider is string && data.provider.size() <= 64 &&
             data.name is string && data.name.size() <= 128 &&
             data.type is string && data.type.size() <= 64 &&
             data.status is string && data.status.size() <= 32 &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Validation Blueprint for CyberGym Credentials
    function isValidCyberGymCredential(data) {
      return data.keys().hasAll(['athleteOrEntity', 'title', 'category', 'status', 'issuedAt']) &&
             data.athleteOrEntity is string && data.athleteOrEntity.size() <= 128 &&
             data.title is string && data.title.size() <= 256 &&
             data.category is string && data.category.size() <= 64 &&
             data.status is string && data.status.size() <= 32 &&
             data.issuedAt is string && data.issuedAt.size() <= 64;
    }

    // Boot-time connectivity test path
    match /test/{docId} {
      allow get: if true;
      allow list, write: if false;
    }

    // User Accounts & Data Isolated per UID
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(incoming());
      allow update: if isValidId(userId) && isOwner(userId) && isValidUser(incoming()) && incoming().uid == existing().uid;
      allow delete: if false;

      // User's AI Ability History
      match /abilities_history/{recordId} {
        allow get: if isValidId(recordId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isValidId(recordId) && isOwner(userId) && isValidAbilityRecord(incoming());
        allow update: if isValidId(recordId) && isOwner(userId) && isValidAbilityRecord(incoming());
        allow delete: if isValidId(recordId) && isOwner(userId);
      }

      // User's Chat Messages
      match /chat_messages/{messageId} {
        allow get: if isValidId(messageId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isValidId(messageId) && isOwner(userId) && isValidChatMessage(incoming());
        allow update: if false;
        allow delete: if isValidId(messageId) && isOwner(userId);
      }

      // User's Portfolio Growth Plans
      match /portfolio_plans/{planId} {
        allow get: if isValidId(planId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isValidId(planId) && isOwner(userId) && isValidPortfolioPlan(incoming());
        allow update: if isValidId(planId) && isOwner(userId) && isValidPortfolioPlan(incoming());
        allow delete: if isValidId(planId) && isOwner(userId);
      }

      // User's Trading Credentials (Exchange API, FIX, DEX)
      match /trading_credentials/{credentialId} {
        allow get: if isValidId(credentialId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isValidId(credentialId) && isOwner(userId) && isValidTradingCredential(incoming());
        allow update: if isValidId(credentialId) && isOwner(userId) && isValidTradingCredential(incoming());
        allow delete: if isValidId(credentialId) && isOwner(userId);
      }

      // User's CyberGym Credentials (Passports, Grants, NIST, Badges)
      match /cybergym_credentials/{credentialId} {
        allow get: if isValidId(credentialId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isValidId(credentialId) && isOwner(userId) && isValidCyberGymCredential(incoming());
        allow update: if isValidId(credentialId) && isOwner(userId) && isValidCyberGymCredential(incoming());
        allow delete: if isValidId(credentialId) && isOwner(userId);
      }
    }
  }
}
