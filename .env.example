# Aegentix Super-Agent-Wallet Environment Configuration Template
PORT=3000
NODE_ENV=production

# Frontier AI & Model Endpoints
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
GROK_API_KEY=YOUR_GROK_API_KEY_HERE
SPARKX_ENDPOINT=http://127.0.0.1:8000/v1
CHATTERBOX_VOICE_ENDPOINT=http://127.0.0.1:8105

# OmniCyberDex XRPL app (Xaman). Server-only.
# Destination: this repository-root .env file, loaded by dotenv.config() in server.ts.
# GET /api/xaman/readiness reports whether these are set and does not return the values.
# Leave both blank in git. Simulation features run with XAMAN_API_SECRET empty.
# Do not paste either value into the browser or POST /api/xaman/save-credentials.
XAMAN_API_KEY=
XAMAN_API_SECRET=

# Exchange & Blockchain Oracles
COINBASE_API_KEY=
COINBASE_API_SECRET=
BINANCE_US_API_KEY=
BINANCE_US_API_SECRET=
XRPL_NODE_URL=wss://xrplcluster.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Federal & Compliance Attestation
SAM_GOV_API_KEY=
FEDRAMP_LEVEL=HIGH
CAGE_CODE=
