# Aegentix Super-Agent-Wallet environment template.
# Copy to .env and fill values only on the server. Leave this file empty of secrets.

PORT=3000
NODE_ENV=production

# Model providers. Required only for the feature that calls them.
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
GROK_API_KEY=
XAI_API_KEY=

# Local model endpoints (not credentials).
SPARKX_ENDPOINT=http://127.0.0.1:8000/v1
CHATTERBOX_VOICE_ENDPOINT=http://127.0.0.1:8105

# Exchanges. Required only for the adapter that uses them. Never commit values.
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_API_KEY_NAME=
COINBASE_API_PRIVATE_KEY=
COINBASE_JWT=
BINANCE_US_API_KEY=
BINANCE_US_API_SECRET=

# Xaman / Xumm. Server-only. Both must be set together or the routes return 503.
XAMAN_API_KEY=
XAMAN_API_SECRET=
XUMM_API_KEY=
XUMM_API_SECRET=

# Moltbook. Heartbeat stays off unless MOLTBOOK_HEARTBEAT=1 and MOLTBOOK_API_KEY is set.
MOLTBOOK_API_KEY=
MOLTBOOK_AGENT_HANDLE=
MOLTBOOK_CLAIM_URL=
MOLTBOOK_VERIFICATION_CODE=
MOLTBOOK_HEARTBEAT=

# Firebase web config. Browser key only; do not put a service-account private key here.
VITE_FIREBASE_API_KEY=
FIREBASE_API_KEY=

# OBS Studio WebSocket v5 password. Local machine setting, not a cloud key.
OBS_WEBSOCKET_PASSWORD=

# Public chain endpoints (not credentials).
XRPL_NODE_URL=wss://xrplcluster.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional compliance metadata. Not a credential by itself.
SAM_GOV_API_KEY=
FEDRAMP_LEVEL=HIGH
CAGE_CODE=
